{
  "name": "AMD ROCm TensorFlow",
  "image": "rocm/tensorflow:latest",
  "runArgs": [
    "--network=host",
    "--device=/dev/kfd",
    "--device=/dev/dri",
    "--ipc=host",
    "--shm-size=16G",
    "--group-add=video",
    "--cap-add=SYS_PTRACE",
    "--security-opt=seccomp=unconfined"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  }
}